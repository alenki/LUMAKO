# Build-time SEO verification tokens (PUBLIC — they render into <head>).
#
# Statically-prerendered metadata can't read Cloudflare Worker runtime bindings, so
# these must be NEXT_PUBLIC_* vars available to the build step (`next build` /
# `opennextjs-cloudflare build`). Copy this file to `.env` (gitignored) and fill in.
# When a value is left blank, its <meta> tag is simply omitted and the build still
# succeeds — so this is optional for local dev.

# Google Search Console → property → Settings → Ownership verification → "HTML tag":
#   copy the value inside content="..." (the token only, not the whole tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Yandex.Webmaster → add site → "Meta tag" method: copy the content="..." token.
# Verifying unlocks Webmaster, where you set Site region = Russia (Display in search →
# Site region) — that region assignment is the real Russia-targeting lever, not code.
NEXT_PUBLIC_YANDEX_VERIFICATION=

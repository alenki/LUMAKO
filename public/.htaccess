# Apache config for the statically-exported Lumako site on reg.ru shared hosting.
# Routes export as <route>/index.html (trailingSlash: true in next.config.ts),
# so Apache's default DirectoryIndex resolves clean URLs with no rewrites.

DirectoryIndex index.html

# Next's static export emits a 404.html - serve it for unknown paths.
ErrorDocument 404 /404.html

# The OG/Twitter social cards export as extension-less files (/opengraph-image,
# /twitter-image), so Apache would serve them as octet-stream and break link
# previews. Force the PNG content-type so scrapers (Telegram, VK, X, Facebook)
# render them.
<FilesMatch "^(opengraph-image|twitter-image)$">
  ForceType image/png
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS. The X-Forwarded-Proto check avoids a redirect loop when reg.ru
  # terminates SSL at an upstream proxy (Apache then sees plain HTTP even on a
  # secure request). Simplest alternative: toggle "Force HTTPS" in the reg.ru
  # panel and delete this block.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Build assets under /_next/static are content-hashed, so cache them hard while
# letting HTML revalidate on every request.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Gzip text assets if mod_deflate is available.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
